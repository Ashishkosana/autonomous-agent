# Copy to .env (git-ignored) or export in your shell. Values are secrets: never commit them.
# In Cursor Cloud Agents, add these under Cloud Agents > Secrets instead of a file.

# --- Deploying the gateway Worker (npm run worker:deploy / worker:secret) ---
# API token: "Edit Cloudflare Workers" template is a good starting point. Account must be on Workers Paid.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Running the real-sandbox integration tests (npm run test:cloudflare) ---
# URL printed by `wrangler deploy`, e.g. https://agent-sandbox-gateway.<subdomain>.workers.dev
AGENT_SANDBOX_GATEWAY_URL=
# The same value you stored with `npm run worker:secret` (openssl rand -hex 32)
AGENT_SANDBOX_GATEWAY_TOKEN=

# --- Real model endpoint (npm run test:model) — any OpenAI-compatible server (ADR-003) ---
# Leave AGENT_MODEL_PROVIDER unset and no real model is configured (tests use the scripted model).
# AGENT_MODEL_PROVIDER=openai-compatible
# Endpoint root. Examples: https://openrouter.ai/api/v1 · https://api.groq.com/openai/v1
#   · https://generativelanguage.googleapis.com/v1beta/openai · http://localhost:11434/v1 (Ollama, keyless)
# AGENT_MODEL_BASE_URL=
# Model identifier exactly as the endpoint expects it
# AGENT_MODEL_NAME=
# Secret. Optional for keyless local servers. Never logged, never in events, never committed.
# AGENT_MODEL_API_KEY=
# Optional telemetry label shown in MODEL_CALL_* events (default: openai-compatible)
# AGENT_MODEL_LABEL=
# Optional tuning: per-call deadline; how structured output / tool actions are requested
# AGENT_MODEL_TIMEOUT_MS=60000
# AGENT_MODEL_STRUCTURED_MODE=json_schema   # json_schema | json_object | prompt
# AGENT_MODEL_TOOL_MODE=tools               # tools | json
# AGENT_MODEL_TEMPERATURE=
# Optional extra request headers as a JSON object (values are treated as secrets)
# AGENT_MODEL_EXTRA_HEADERS={"HTTP-Referer":"https://example.test","X-Title":"autonomous-agent"}
# Force the real-model suite to FAIL instead of skip when no endpoint is configured (test:model sets this)
# AGENT_REQUIRE_REAL_MODEL=1

# --- Local Docker sandbox (npm run test:local) — no secrets needed ---
# Opt in to the real Docker suite during a plain `npm test` (test:local sets the REQUIRE form itself)
# AGENT_LOCAL_DOCKER=1
# Force the Docker suite to FAIL instead of skip when Docker or the image is missing
# AGENT_REQUIRE_LOCAL_DOCKER=1

# Optional: where integration tests write evidence JSON (default <os tmp>/agent-sandbox-evidence)
# AGENT_SANDBOX_EVIDENCE_DIR=
# Optional: enables the slow idle-stop lifecycle observation (must exceed AGENT_SANDBOX_SLEEP_AFTER)
# AGENT_SANDBOX_IDLE_WAIT_MS=360000
