    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
