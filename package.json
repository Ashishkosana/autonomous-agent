{
  "name": "autonomous-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Observable autonomous learning agent — V1 architecture skeleton",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
