{
  "name": "autonomous-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A measurable memory-augmented autonomous agent with deterministic evaluation and observability.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cloudflare": "AGENT_REQUIRE_CLOUDFLARE=1 vitest run tests/integration/cloudflare",
    "test:local": "node scripts/test-local.mjs",
    "test:model": "node scripts/test-model.mjs",
    "check": "npm run format:check && npm run typecheck && npm run test",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc",
    "worker:secret": "wrangler secret put AGENT_SANDBOX_GATEWAY_TOKEN -c worker/wrangler.jsonc",
    "worker:tail": "wrangler tail -c worker/wrangler.jsonc",
    "sandbox:build": "node scripts/sandbox-image.mjs build",
    "sandbox:clean": "node scripts/sandbox-image.mjs clean",
    "sandbox:remove": "node scripts/sandbox-image.mjs remove",
    "agent": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs scripts/agent.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@types/node": "^22.20.4",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9"
  }
}
